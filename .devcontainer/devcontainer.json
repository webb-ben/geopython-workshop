{
  "name": "GeoPython",
  "image": "geopython/geopython-workshop:latest",
  "runArgs": ["jupyter notebook --ip 0.0.0.0 --no-browser --port 8888 --allow-root --NotebookApp.token=''"],
  "workspaceMount": "source= /workspaces/${localWorkspaceFolderBasename}/workshop/jupyter/content,target=/jupyter/content,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8888, 8001],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postStartCommand": "docker compose -f /workspaces/${localWorkspaceFolderBasename}/workshop/docker-compose-services.yml up -d"
}
